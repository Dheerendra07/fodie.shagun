# FoodieHub API production configuration
NODE_ENV=production
PORT=3000
DATA_DIR=/var/data
ALLOWED_ORIGINS=https://shagun299.github.io
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
